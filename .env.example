# Compose deployment settings. Generate secrets with: python scripts/generate_secrets.py
ATLAS_API_KEY=
ATLAS_DB_PASSWORD=

# Defaults run the four deterministic demos. Real repositories need a model server.
ATLAS_BACKEND=demo
ATLAS_MODEL_URL=http://127.0.0.1:8080/v1
ATLAS_MODEL_NAME=local-model
ATLAS_MODEL_API_KEY=
ATLAS_SMALL_MODEL_NAME=

# Local Python commands read shell environment variables, not this file.
# These paths must match in API and standalone worker processes.
ATLAS_DATA_DIR=./data
ATLAS_REPO_ROOT=./repositories
ATLAS_DATABASE_URL=sqlite:///./data/atlas.db
ATLAS_WORKER_CONCURRENCY=2
ATLAS_WORKER_METRICS_PORT=9091
ATLAS_INFERENCE_CONCURRENCY=2
ATLAS_KV_BUDGET_BYTES=2147483648
ATLAS_OTLP_ENDPOINT=
